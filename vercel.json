{
  "rewrites": [
    {
      "source": "/api/reviews/:id",
      "destination": "/api/reviews?id=:id"
    },
    {
      "source": "/api/projects/:id",
      "destination": "/api/projects?id=:id"
    },
    {
      "source": "/api/students/:id",
      "destination": "/api/students?id=:id"
    },
    {
      "source": "/api/posts/:slug",
      "destination": "/api/posts?slug=:slug"
    }
  ],
  "functions": {
    "api/auth/[action].js": {
      "maxDuration": 10
    },
    "api/comments/[slug].js": {
      "maxDuration": 10
    },
    "api/contact.js": {
      "maxDuration": 10
    },
    "api/cover.js": {
      "maxDuration": 10
    },
    "api/estimate.js": {
      "maxDuration": 10
    },
    "api/posts.js": {
      "maxDuration": 10
    },
    "api/projects.js": {
      "maxDuration": 10
    },
    "api/reviews.js": {
      "maxDuration": 10
    },
    "api/students.js": {
      "maxDuration": 10
    },
    "api/upload.js": {
      "maxDuration": 60
    }
  },
  "headers": [
    {
      "source": "/(.*)\\.(css|js|svg|png|jpg|webp|ico)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)\\.html",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=0, s-maxage=3600, stale-while-revalidate=86400"
        }
      ]
    }
  ]
}